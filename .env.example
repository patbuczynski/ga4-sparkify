# Copy to .env and fill in real values. Loaded via ${VAR} interpolation in the
# YAML configs (ga4_sparkify/config.py) or read directly by run.sh.

# GCP project id. Used in examples/flatten_events_bigquery.yaml and
# examples/flatten_sessions_bigquery.yaml (source table, sink project).
GCP_PROJECT=my-gcp-project

# GCS bucket (no gs:// prefix, no trailing slash) holding GA4-export data and
# job output. Used in examples/flatten_events_gcs.yaml.
GCS_BUCKET=my-ga4-bucket

# GCS bucket used to stage BigQuery "indirect" writes (spark-bigquery connector
# temporaryGcsBucket). Used in examples/flatten_events_bigquery.yaml and
# examples/flatten_sessions_bigquery.yaml.
GCS_TEMP_BUCKET=my-bq-temp-bucket

# Driver heap for local Spark runs (run.sh). Optional -- defaults to 4g.
SPARK_DRIVER_MEMORY=4g
